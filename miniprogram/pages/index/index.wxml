<view class="container">
  <view class="hero showcase">
    <text class="eyebrow">2026 成人高考</text>
    <text class="title">在线报名服务</text>
  </view>
  <view class="card welcome-card">
    <text class="section">2026 年招生报名入口</text>
    <text class="muted">请提前准备身份证、学历和本人联系方式，报名信息可暂存后继续填写。</text>
    <text wx:if="{{error}}">{{error}}</text>
    <button class="primary large" loading="{{busy}}" disabled="{{busy}}" bindtap="goMine">立即登录报名</button>
  </view>

  <view class="card welcome-card">
    <text class="section">管理员入口</text>
    <text class="muted">老师首次使用请绑定管理账号</text>
    <button class="primary large" loading="{{busy}}" disabled="{{busy}}" bindtap="goLogin">登录</button>
  </view>
</view>