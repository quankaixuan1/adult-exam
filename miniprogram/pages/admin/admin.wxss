.admin{padding:28rpx;background:#f3f6fb;min-height:100vh;color:#17233c}.heading{display:flex;justify-content:space-between;padding:24rpx 0}.title{display:block;font-size:34rpx;font-weight:600;margin-bottom:16rpx}.tabs,.actions{display:flex;gap:10rpx;align-items:center;flex-wrap:wrap}.tabs button,.actions button{font-size:26rpx;flex:1;padding:0 12rpx}.card{background:white;border-radius:20rpx;padding:28rpx;margin:24rpx 0;line-height:1.8;overflow-wrap:anywhere}.card input,.card textarea,.picker{background:#f4f6fa;border-radius:12rpx;padding:20rpx;margin:16rpx 0;box-sizing:border-box;width:100%;min-height:76rpx}.line{display:flex;justify-content:space-between;gap:24rpx;padding:14rpx 0;border-bottom:1rpx solid #edf1f6}.line text:first-child{color:#71809c;flex-shrink:0}.badge{color:#245acf;margin-top:12rpx}.error{color:#b42318;background:#fff0ee;padding:20rpx}.notice{padding:24rpx;color:#71809c}.primary{background:#245acf;color:white}button{margin-top:14rpx}
.referral-content{text-align:center}.referral-image{display:block;width:384rpx;max-width:100%;margin:0 auto 16rpx;border:1rpx solid #edf1f6;border-radius:12rpx}
