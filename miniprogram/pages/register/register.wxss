.form-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  width: 100%;
  margin-bottom: 24rpx;
}

.form-row .label {
  width: 190rpx;
  flex-shrink: 0;
  margin: 0;
}

.form-input,
.form-picker {
  flex: 1;
  min-width: 0;
}

.form-input,
.form-picker .picker {
  width: 100%;
  height: 76rpx;
  line-height: 76rpx;
  box-sizing: border-box;
  padding: 0 20rpx;
  background: #f3f6fb;
  border: 1rpx solid #dde3ec;
  border-radius: 12rpx;
  font-size: 28rpx;
}

.form-row:last-child {
  margin-bottom: 0;
}
