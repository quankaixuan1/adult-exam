<view class="admin"><view class="heading"><text class="title">招生管理</text><text>{{admin.displayName}}</text></view><button bindtap="referral" disabled="{{busy}}">我的学生报名二维码</button><view wx:if="{{referralCode}}" class="card"><image src="{{referralCode.image}}" show-menu-by-longpress mode="widthFix"/><view>{{referralCode.teacherName}} · {{referralCode.campus || '待分配校区'}}</view></view><view class="tabs"><button data-tab="registrations" bindtap="switchTab">报名</button><button data-tab="programs" bindtap="switchTab">专业</button><button data-tab="notifications" bindtap="switchTab">消息</button><button wx:if="{{admin.role==='super'}}" data-tab="accounts" bindtap="switchTab">账号</button></view><view wx:if="{{busy}}" class="notice">正在处理…</view><view wx:if="{{error}}" class="error">{{error}}</view>
<block wx:if="{{editing}}"><view class="card"><text class="title">{{form.id?'修改报名':'新增报名'}}</text><view wx:for="{{fields}}" wx:key="*this"><text>{{item[1]}}</text><input value="{{form[item[0]]}}" data-key="{{'form.'+item[0]}}" bindinput="input"/></view><picker wx:for="{{pickers}}" wx:key="key" range="{{item.values}}" data-index="{{index}}" bindchange="pick"><view class="picker">{{item.label}}：{{item.current||'请选择'}}</view></picker><view>工会会员<switch checked="{{form.unionMember}}" data-key="unionMember" bindchange="toggle"/></view><view>退役军人<switch checked="{{form.veteran}}" data-key="veteran" bindchange="toggle"/></view><text>缴费明细（填写时请完整填写三项）</text><input type="digit" placeholder="考试费" value="{{form.paymentBreakdown.exam}}" data-key="form.paymentBreakdown.exam" bindinput="input"/><input type="digit" placeholder="教材资料费" value="{{form.paymentBreakdown.materials}}" data-key="form.paymentBreakdown.materials" bindinput="input"/><input type="digit" placeholder="高复学费" value="{{form.paymentBreakdown.tuition}}" data-key="form.paymentBreakdown.tuition" bindinput="input"/><button bindtap="proofsUpload" disabled="{{busy}}">选择缴费凭证 {{form.paymentProofUploads.length||0}} 张</button><button class="primary" bindtap="save" disabled="{{busy}}">保存报名</button><button bindtap="close">取消</button></view></block>
<block wx:elif="{{selected}}"><view class="card"><text class="title">{{selected.name}}</text><view wx:for="{{detailFields}}" wx:key="label" class="line"><text>{{item.label}}</text><text selectable>{{item.value}}</text></view><view wx:if="{{canMaterials}}"><button wx:for="{{materials}}" wx:key="kind" data-kind="{{item.kind}}" bindtap="material">{{item.label}}</button><button wx:for="{{proofs}}" wx:key="index" data-kind="paymentProof" data-index="{{index}}" bindtap="material">缴费凭证 {{index+1}}</button></view><button wx:if="{{canEdit}}" bindtap="edit">修改报名</button><textarea placeholder="审核意见（驳回时填写原因）" data-key="remark" bindinput="input" value="{{remark}}"/><view wx:if="{{canReview}}"><button disabled="{{busy}}" data-action="review" data-value="approved" bindtap="review">报名审核通过</button><button disabled="{{busy}}" data-action="review" data-value="rejected" bindtap="review">要求补充材料</button><button disabled="{{busy}}" data-action="review" data-value="pending" bindtap="review">设为待审核</button></view><view wx:if="{{canPayment && (selected.paymentStatus==='finance_pending'||selected.paymentStatus==='teacher_pending')}}"><button disabled="{{busy}}" data-action="reviewPayment" data-value="approve" bindtap="review">确认缴费</button><button disabled="{{busy}}" data-action="reviewPayment" data-value="reject" bindtap="review">驳回缴费</button></view><button bindtap="close">返回</button></view></block>
<block wx:elif="{{tab==='registrations'}}"><view class="card">全部 {{stats.total}} · 待审核 {{stats.pending}} · 通过 {{stats.approved}} · 未通过 {{stats.rejected}}</view><view class="card"><input placeholder="姓名或手机号" value="{{keyword}}" data-key="keyword" bindinput="input" bindconfirm="search"/><view class="actions"><button bindtap="search">搜索</button><button bindtap="reset">重置</button><button bindtap="statistics">统计</button><button bindtap="exportRows" disabled="{{busy}}">导出 CSV</button><button wx:if="{{canCreate}}" data-new="true" bindtap="edit">新增</button></view><picker wx:for="{{filters}}" wx:key="key" range="{{item.values}}" data-index="{{index}}" bindchange="filter"><view class="picker">{{item.label}}：{{query[item.key]||'全部'}}</view></picker></view><view class="card" wx:for="{{groups}}" wx:key="label"><text>{{item.label}}</text><view wx:for="{{item.items}}" wx:key="key">{{item.label}}：{{item.count}}</view></view><view class="card" wx:for="{{rows}}" wx:key="id" data-id="{{item.id}}" bindtap="detail"><text class="title">{{item.name}} · {{item.phone}}</text><view>{{item.school}} · {{item.level}}</view><view>{{item.major}}</view><view>{{item.studyCampus||'待定'}} · {{item.teacherName||'待分配'}}</view><view class="badge">{{item.statusLabel}} · {{item.paymentLabel}}</view></view><view wx:if="{{!rows.length && !busy}}" class="notice">暂无符合条件的报名</view><view class="actions"><button disabled="{{busy||page<=1}}" data-step="-1" bindtap="page">上一页</button><text>{{page}} 页 / {{filteredTotal}} 条</text><button disabled="{{busy||page*pageSize>=filteredTotal}}" data-step="1" bindtap="page">下一页</button></view></block>
<block wx:elif="{{tab==='programs'}}"><view class="card" wx:for="{{programs}}" wx:key="id"><text class="title">{{item.school}}</text><view>{{item.level}} · {{item.major}}</view><view>{{item.duration}} · {{item.studyMode}} · ¥{{item.fee}}</view><view>{{item.examCategory}}</view></view></block>
<block wx:elif="{{tab==='notifications'}}"><view class="notice">未读消息 {{unreadTotal||0}}</view><view class="card" wx:for="{{notifications}}" wx:key="id" data-id="{{item.registrationId}}" data-notification="{{item.id}}" bindtap="detail">{{item.studentName}} · 报名更新<view>{{item.createdAt}}</view></view></block>
<block wx:elif="{{tab==='accounts'}}"><view wx:if="{{account}}" class="card"><input placeholder="账号" value="{{account.username}}" disabled="{{account.id}}" data-key="account.username" bindinput="input"/><input placeholder="显示名称" value="{{account.displayName}}" data-key="account.displayName" bindinput="input"/><input placeholder="密码（修改时留空保留）" password data-key="account.password" bindinput="input"/><picker range="{{organization.members}}" range-key="name" bindchange="member"><view class="picker">组织成员：{{account.memberId||'请选择'}}</view></picker><checkbox-group bindchange="permission"><label wx:for="{{permissionChecks}}" wx:key="key" class="line"><checkbox value="{{item.key}}" checked="{{item.checked}}"/>{{item.key}}</label></checkbox-group><view>停用账号<switch checked="{{account.disabled}}" bindchange="disabled"/></view><button bindtap="saveAccount" disabled="{{busy}}">保存账号</button><button bindtap="close">取消</button></view><block wx:else><button bindtap="editAccount">新增账号</button><view class="card" wx:for="{{accounts}}" wx:key="id"><text>{{item.displayName}} · {{item.username}} {{item.disabled?'（停用）':''}}</text><view wx:if="{{item.role!=='super'}}"><button data-id="{{item.id}}" bindtap="editAccount">编辑权限</button><button data-id="{{item.id}}" bindtap="deleteAccount">删除</button></view></view></block></block><button bindtap="logout" disabled="{{busy}}">退出登录</button></view>