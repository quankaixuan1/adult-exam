.form-row {
  display: flex;
  align-items: center;
  width: 100%;
  margin-bottom: 24rpx;
}
.form-row .label { width: 190rpx; flex-shrink: 0; margin: 0; }
.form-picker { flex: 1; min-width: 0; }
.custom-input {
  flex: 1;
  min-width: 0;
  height: 76rpx;
  box-sizing: border-box;
  padding: 0 20rpx;
  background: #f3f6fb;
  border: 1rpx solid #dde3ec;
  border-radius: 12rpx;
  font-size: 28rpx;
}
.form-picker .picker {
  width: 100%;
  min-height: 76rpx;
  line-height: 40rpx;
  box-sizing: border-box;
  padding: 17rpx 20rpx;
  white-space: normal;
  overflow-wrap: anywhere;
  background: #f3f6fb;
  border: 1rpx solid #dde3ec;
  border-radius: 12rpx;
  font-size: 28rpx;
}
.program-detail { margin-top: 24rpx; }
.consent-row { display: flex; align-items: flex-start; gap: 12rpx; }
