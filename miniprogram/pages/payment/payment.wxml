<view class="container">
  <view class="stepper"><text class="step done">✓ 填写</text><text class="step done">✓ 核对</text><text class="step active">3 缴费</text></view>
  <text wx:if="{{busy && !registration}}" class="muted center">正在读取报名信息…</text>
  <block wx:elif="{{registration && !complete}}">
    <text class="title">报名缴费</text>
    <view class="demo-tag">缴费功能演示 · 不会发起真实付款</view>
    <view class="card order-card">
      <text class="muted">报名项目</text><text class="section">{{registration.school}}</text>
      <text>{{registration.level}} · {{registration.major}}</text>
      <view class="pay-line"><text>应缴金额</text><text class="price">¥{{registration.fee}}</text></view>
    </view>
    <view class="card"><view class="pay-method"><view class="wechat-pay">✓</view><view><text class="section small">微信支付</text><text class="muted">正式版接入商户号后启用</text></view><text class="selected">●</text></view></view>
    <button class="primary" bindtap="finish" loading="{{busy}}" disabled="{{busy}}">模拟支付完成</button>
    <text class="muted center">此按钮仅演示缴费流程，不产生真实订单或资金交易。</text>
  </block>
  <view wx:elif="{{complete}}" class="success-card">
    <view class="success-icon">✓</view><text class="title center">报名成功</text>
    <view class="demo-tag">已完成模拟缴费 · 未产生真实付款</view>
    <text class="muted center">报名已登记，管理员将收到提醒。请在“我的报名”上传材料并查看审核进度。</text>
    <button class="primary" bindtap="mine">查看我的报名</button>
    <button bindtap="home">返回首页</button>
    <button bindtap="restart" disabled="{{busy}}">清除演示报名，重新体验</button>
  </view>
  <text wx:if="{{error}}" class="error">{{error}}</text>
  <button wx:if="{{error && !registration}}" bindtap="onLoad" disabled="{{busy}}">重新加载</button>
</view>
