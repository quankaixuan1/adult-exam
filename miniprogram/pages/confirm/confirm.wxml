<view class="container">
  <!-- <view class="stepper"><text class="step done">✓ 填写</text><text class="step active">2 核对</text><text class="step">3 缴费</text></view> -->
  <view class="stepper"><text class="step done">✓ 个人信息</text><text class="step done">✓ 报考志愿</text><text class="step active">3 核对报名</text></view>
  <text class="title">请核对报名信息</text>
  <view class="card summary">
    <view class="summary-row"><text>姓名</text><text>{{draft.name}}</text></view><view class="summary-row"><text>性别与民族</text><text>{{draft.gender}} · {{draft.ethnicity}}</text></view>
    <view class="summary-row"><text>身份证号</text><text>{{draft.idNumberMasked}}</text></view>
    <view class="summary-row"><text>手机号码</text><text>{{draft.phone}}</text></view><view class="summary-row"><text>当前学历</text><text>{{draft.education}}</text></view>
    <view class="summary-row"><text>工作单位</text><text>{{draft.workUnit || '—'}}</text></view>
    <view class="summary-row"><text>政治面貌</text><text>{{draft.politicalStatus || '—'}}</text></view>
    <view class="summary-row"><text>工会会员</text><text>{{draft.unionMember ? '是' : '否'}}</text></view>
    <view class="summary-row"><text>退役军人</text><text>{{draft.veteran ? '是' : '否'}}</text></view>
    <view class="summary-row"><text>第二联系人</text><text>{{draft.emergencyName || '—'}}</text></view>
    <view class="summary-row"><text>联系人电话</text><text>{{draft.emergencyPhone || '—'}}</text></view>
    <view class="summary-row"><text>现居住地址</text><text>{{draft.currentAddress}}</text></view><view class="summary-row"><text>报考学校</text><text>{{draft.program.school}}</text></view>
    <view class="summary-row"><text>报考层次</text><text>{{draft.program.level}}</text></view>
    <view class="summary-row"><text>报考专业</text><text>{{draft.program.major}}</text></view><view class="summary-row"><text>学制</text><text>{{draft.program.duration}}</text></view>
    <view class="summary-row"><text>学习形式</text><text>{{draft.program.studyMode}}</text></view>
    <view class="summary-row"><text>考试科目</text><text>{{draft.program.examCategory}}</text></view>
  </view>
  <view class="fee-card"><text>应缴金额</text><text class="price">¥{{draft.program.fee}}</text><text class="muted">提交后请联系报名老师完成缴费</text></view>
  <view class="notice">提交后可在“我的账号”继续上传身份证、学历证明和证件照。</view>
  <text wx:if="{{error}}" class="error">{{error}}</text><button class="primary" bindtap="confirm" loading="{{busy}}" disabled="{{busy}}" style="position: relative; left: 0rpx; top: -2rpx">确认无误，提交报名</button>
  <button bindtap="back" disabled="{{busy}}">返回修改</button>
</view>
